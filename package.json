{
  "name": "baseline-planning-suite",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:tz": "TZ=America/Los_Angeles vitest run && TZ=Pacific/Auckland vitest run",
    "test:contracts": "vitest run integration apps/delivery/tests/contracts apps/people/tests/contracts",
    "seed:slices": "tsx scripts/make-seed-slices.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
